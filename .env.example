LLM_MODEL=openai:gpt-5-mini
LLM_BASE_URL=
LLM_API_KEY=

EMBEDDING_MODEL=openai:text-embedding-3-small
OPENAI_API_KEY=

POSTGRES_USER=accordance
POSTGRES_DB=accordance
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://accordance:replace-with-a-strong-password@db:5432/accordance
DB_HOST_PORT=5432

DATA_DIR=./data
MAX_UPLOAD_MB=100
MAX_REQUEST_MB=0
JUDGE_CONCURRENCY=3
MAX_CONCURRENT_RUNS=4
MAX_INFLIGHT_RUNS_PER_USER=5
SHUTDOWN_DRAIN_SECONDS=25
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

VISION_FALLBACK_ENABLED=true
VISION_FALLBACK_ON_LOW_CONFIDENCE=true
VISION_FALLBACK_BUDGET=40
JUDGE_REJUDGE_ON_MISSING=true

RETRIEVAL_MODE=hybrid
RETRIEVAL_PER_ELEMENT=true
RETRIEVAL_TAG_AWARE=false
RETRIEVAL_TAG_LIMIT=5
RERANK_ENABLED=false
RERANK_MODEL=ms-marco-MultiBERT-L-12
RERANK_TOP_N=15
PROMPT_CACHE_ENABLED=false

EXTRACTOR_BACKEND=pymupdf
DOCLING_BATCH_SIZE=50
DOCLING_TIMEOUT_SECONDS=0
DOCLING_DO_OCR=false
DOCLING_DO_TABLE_STRUCTURE=false
DOCLING_NUM_THREADS=1
DOCLING_IMAGES_SCALE=1.0
DOCLING_LAYOUT_BATCH_SIZE=1
DOCLING_OCR_BATCH_SIZE=1
DOCLING_TABLE_BATCH_SIZE=1

SESSION_TTL_DAYS=14
SESSION_COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
