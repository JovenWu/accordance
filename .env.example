# Copy to .env and fill in the REQUIRED keys below. Everything else has a
# working default; uncomment only what you need to change.

# ── Required: LLM judge ──────────────────────────────────────
# OpenAI by default. Set LLM_BASE_URL only to route through an OpenAI-compatible
# proxy (end it in /v1 if the proxy expects that).
LLM_MODEL=openai:gpt-5-mini
LLM_BASE_URL=
LLM_API_KEY=

# ── Required: Embeddings ─────────────────────────────────────
EMBEDDING_MODEL=openai:text-embedding-3-small
OPENAI_API_KEY=
# VOYAGE_API_KEY=                  # only if EMBEDDING_MODEL starts with voyage:

# ── Cost dashboard (optional) ────────────────────────────────
# USD per 1M tokens. The key MUST match the model name the provider RETURNS,
# not LLM_MODEL. Unpriced models record $0 (warned at startup).
# MODEL_PRICES_JSON={"gpt-5-mini":{"in":0.25,"out":2.0}}

# ── Datastore (PostgreSQL) ───────────────────────────────────
# PostgreSQL connection (the app's datastore). Compose initializes an empty volume with these.
# Changing credentials on an existing volume requires a database migration.
POSTGRES_USER=accordance
POSTGRES_DB=accordance
POSTGRES_PASSWORD=                      # set a strong, unique value before starting
DATABASE_URL=postgresql://accordance:replace-with-a-strong-password@db:5432/accordance   # inside compose; use localhost:5432 for host-run dev
# Host port the compose `db` service publishes (container always listens on 5432).
# Override only if 5432 is already taken on your machine; then host-run tests use
# TEST_DATABASE_URL=postgresql://accordance:<POSTGRES_PASSWORD>@localhost:<DB_HOST_PORT>/accordance
DB_HOST_PORT=5432

# ── Storage + concurrency ────────────────────────────────────
DATA_DIR=./data                   # forced to /app/data inside the container
MAX_UPLOAD_MB=100
MAX_REQUEST_MB=0                  # 0 => MAX_UPLOAD_MB + 8; hard body cap (413 at the door)
JUDGE_CONCURRENCY=3               # parallel judge calls within a run
MAX_CONCURRENT_RUNS=4             # parallel runs; excess queue
MAX_INFLIGHT_RUNS_PER_USER=5     # per-user in-flight run cap; excess get 429
SHUTDOWN_DRAIN_SECONDS=25         # keep < compose stop_grace_period (30s)
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ── Vision fallback ──────────────────────────────────────────
VISION_FALLBACK_ENABLED=true
VISION_FALLBACK_ON_LOW_CONFIDENCE=true
VISION_FALLBACK_BUDGET=40
JUDGE_REJUDGE_ON_MISSING=true

# ── Retrieval + rerank ───────────────────────────────────────
RETRIEVAL_MODE=hybrid             # hybrid | dense | bm25
RETRIEVAL_PER_ELEMENT=true
RETRIEVAL_TAG_AWARE=false         # enable only with DOCLING_DO_TABLE_STRUCTURE=true
RETRIEVAL_TAG_LIMIT=5
RERANK_ENABLED=false
RERANK_MODEL=ms-marco-MultiBERT-L-12
RERANK_TOP_N=15
PROMPT_CACHE_ENABLED=false

# ── PDF extractor ────────────────────────────────────────────
EXTRACTOR_BACKEND=pymupdf         # pymupdf (default) | docling (OCR/tables)
# Docling only (EXTRACTOR_BACKEND=docling):
DOCLING_BATCH_SIZE=50             # re-instantiate every N pages; 0 disables
DOCLING_TIMEOUT_SECONDS=0         # per-pass wall-clock budget; 0 disables
DOCLING_DO_OCR=false              # true for scanned PDFs
DOCLING_DO_TABLE_STRUCTURE=false  # true for cell-accurate tables
DOCLING_NUM_THREADS=1
DOCLING_IMAGES_SCALE=1.0
DOCLING_LAYOUT_BATCH_SIZE=1
DOCLING_OCR_BATCH_SIZE=1
DOCLING_TABLE_BATCH_SIZE=1

# ── Auth / session ───────────────────────────────────────────
SESSION_TTL_DAYS=14
SESSION_COOKIE_SECURE=false       # REQUIRED true for any HTTPS deployment (else
                                  # the session cookie can travel over plaintext)
LOGIN_MAX_ATTEMPTS=10            # failed logins per IP+username before 429; 0=off
LOGIN_WINDOW_SECONDS=300         # ...within this rolling window

# ── Admin account ────────────────────────────────────────────
# Admin account, provisioned at startup ("set up on build"). When ADMIN_USERNAME
# is set, that account is ensured to exist as an ACTIVE ADMIN every boot. The
# password is applied on creation and re-asserted whenever ADMIN_PASSWORD is
# non-empty (declarative rotation); leave it blank after first boot to keep the
# current password. Must be >= 8 chars or the account is not created. This value
# is readable in the container environment — use a strong secret.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
